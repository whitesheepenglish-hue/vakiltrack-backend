## Local MongoDB (recommended for dev)
# MONGO_URI=mongodb://127.0.0.1:27017/vakiltrack

## MongoDB Atlas SRV format
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vakiltrack?retryWrites=true&w=majority&appName=Cluster0

## MongoDB Atlas standard format (use this if SRV DNS is blocked on your host)
# MONGO_URI=mongodb://whitesheepenglish_db_user:fJnU4tZUsA8aet@HOST1:27017,HOST2:27017,HOST3:27017/vakiltrack?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

## If your password contains special characters like @ : / ? # [ ] use URL encoding.
# REQUIRE_DB=true

# PORT=5000

## Optional: set this if Chrome/Chromium is not in a default location
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

## Render/CI can preinstall Puppeteer's managed browser during build
# npm run build:render

## Redis / BullMQ
# REDIS_URL=redis://127.0.0.1:6379

## Puppeteer parallelism
## Render Starter: 5
## Render Standard: 10-15
## Render Pro: 20+
# MAX_PAGES=10
